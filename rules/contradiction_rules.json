{
  "meta": {
    "name": "TRIO 尽调矛盾发现规则集 v1.0",
    "description": "一级市场尽调中，标的公司自述与公开数据之间的逻辑撕裂检测规则。每条规则定位一个可验证的矛盾类型，输入标的自述材料与公开数据，输出矛盾点。",
    "license": "MIT",
    "version": "1.0.0",
    "rule_count": 22,
    "categories": [
      "财务",
      "专利技术",
      "信用法律",
      "市场客户",
      "行为验证"
    ],
    "usage": "输入：标的自述材料 + 公开数据源；对每条规则做交叉比对；命中则输出矛盾点（含证据、置信度、预测注册）。",
    "extension": "按 category 扩展；每条规则需附来源与失效案例。"
  },
  "rules": [
    {
      "id": "R-001",
      "name": "营收-纳税背离",
      "category": "财务",
      "trigger": "自述营收规模与纳税记录/社保人数不匹配",
      "logic": "若自述营收 X 亿，但纳税额、社保缴纳人数对应的业务体量远低于 X 亿，则存在营收虚增嫌疑",
      "data_sources": [
        "工商年报",
        "纳税申报公开记录",
        "社保缴纳数据"
      ],
      "severity": "high",
      "signals": [
        "纳税记录",
        "社保人数",
        "纳税额"
      ]
    },
    {
      "id": "R-002",
      "name": "营收增速-现金流背离",
      "category": "财务",
      "trigger": "高营收增长但经营现金流长期为负或背离",
      "logic": "营收高增长而经营现金流持续为负，收入质量存疑（可能的关联交易/赊销虚增）",
      "data_sources": [
        "财务报表",
        "现金流数据"
      ],
      "severity": "high",
      "signals": [
        "现金流转",
        "现金流为负",
        "现金流背离",
        "资金链断裂",
        "货币资金",
        "资金链存疑"
      ]
    },
    {
      "id": "R-003",
      "name": "产能利用率-能耗背离",
      "category": "财务",
      "trigger": "自述满产满销但用电量/能耗数据低",
      "logic": "产能利用率与用电量/能耗量级不匹配，产能自述可能虚高",
      "data_sources": [
        "用电量数据",
        "能耗数据",
        "产能自述"
      ],
      "severity": "high",
      "signals": [
        "用电量",
        "能耗数据",
        "满产满销"
      ]
    },
    {
      "id": "R-004",
      "name": "毛利率-行业异常",
      "category": "财务",
      "trigger": "毛利率显著高于行业均值且无合理解释",
      "logic": "毛利率异常高于同业且缺乏成本结构/定价权解释，存在美化嫌疑",
      "data_sources": [
        "行业均值",
        "可比公司财报",
        "毛利率自述"
      ],
      "severity": "medium",
      "signals": [
        "毛利率异常",
        "毛利过高"
      ]
    },
    {
      "id": "R-005",
      "name": "应收账款-营收异常",
      "category": "财务",
      "trigger": "应收账款占营收比例异常高",
      "logic": "应收账款占比过高，营收可能依赖赊销而非真实回款",
      "data_sources": [
        "资产负债表",
        "营收数据"
      ],
      "severity": "medium",
      "signals": [
        "应收账款占比",
        "应收高",
        "赊销"
      ]
    },
    {
      "id": "R-006",
      "name": "存货-营收周转异常",
      "category": "财务",
      "trigger": "存货规模与营收周转速度不匹配",
      "logic": "存货周转异常缓慢或激增，可能存在积压或虚增",
      "data_sources": [
        "存货数据",
        "营收数据"
      ],
      "severity": "low",
      "signals": [
        "存货周转",
        "存货积压",
        "扇贝",
        "存货异常"
      ]
    },
    {
      "id": "R-007",
      "name": "核心专利-数据库背离",
      "category": "专利技术",
      "trigger": "声称核心专利独家，但专利数据库显示已过期/质押/非核心",
      "logic": "专利状态（过期/质押/被驳回）与'独家核心专利'自述矛盾",
      "data_sources": [
        "国家知识产权局专利库",
        "专利状态查询"
      ],
      "severity": "high",
      "signals": [
        "专利质押",
        "专利过期",
        "核心专利"
      ]
    },
    {
      "id": "R-008",
      "name": "技术自研-归属矛盾",
      "category": "专利技术",
      "trigger": "声称技术自研，但专利申请人/权利人非标的公司",
      "logic": "关键技术专利归属他人（高校/前东家/关联方），'自研'自述存疑",
      "data_sources": [
        "专利申请人记录",
        "专利变更记录"
      ],
      "severity": "high",
      "signals": [
        "专利申请",
        "技术专利"
      ]
    },
    {
      "id": "R-009",
      "name": "技术领先-研发投入背离",
      "category": "专利技术",
      "trigger": "声称技术行业领先，但研发投入占比极低",
      "logic": "研发投入与'技术领先'自述量级不匹配",
      "data_sources": [
        "研发费用",
        "行业研发强度"
      ],
      "severity": "medium",
      "signals": [
        "研发投入占比",
        "研发费用低"
      ]
    },
    {
      "id": "R-010",
      "name": "技术路线-认证缺失",
      "category": "专利技术",
      "trigger": "声称具备特定技术资质，但无对应行业认证/标准",
      "logic": "声称的技术能力缺乏行业认证/标准支撑",
      "data_sources": [
        "行业认证名录",
        "标准数据库"
      ],
      "severity": "medium",
      "signals": [
        "认证缺失",
        "无认证",
        "资质"
      ]
    },
    {
      "id": "R-011",
      "name": "实控人-限高失信",
      "category": "信用法律",
      "trigger": "法定代表人/实控人被限高或列入失信",
      "logic": "关键人信用硬伤，与'稳健经营'自述矛盾",
      "data_sources": [
        "限高名单",
        "失信被执行人名单"
      ],
      "severity": "high",
      "signals": [
        "限高",
        "失信",
        "被限高"
      ]
    },
    {
      "id": "R-012",
      "name": "司法风险-自述背离",
      "category": "信用法律",
      "trigger": "声称无重大纠纷，但存在多起诉讼/被执行记录",
      "logic": "司法风险记录与'无纠纷'自述矛盾",
      "data_sources": [
        "裁判文书网",
        "执行信息平台"
      ],
      "severity": "high",
      "signals": [
        "诉讼",
        "被执行",
        "多起"
      ]
    },
    {
      "id": "R-013",
      "name": "股权质押-稳健背离",
      "category": "信用法律",
      "trigger": "实控人高比例股权质押，但自述经营稳健",
      "logic": "高比例质押暗示资金链紧张，与稳健自述矛盾",
      "data_sources": [
        "股权质押记录",
        "工商信息"
      ],
      "severity": "medium",
      "signals": [
        "质押比例",
        "股权质押",
        "冻结"
      ]
    },
    {
      "id": "R-014",
      "name": "工商变更-经营背离",
      "category": "信用法律",
      "trigger": "高管/注册地址/经营范围频繁变更",
      "logic": "频繁工商变更可能与经营不稳/规避监管相关",
      "data_sources": [
        "工商变更记录"
      ],
      "severity": "low",
      "signals": [
        "频繁变更",
        "多次变更"
      ]
    },
    {
      "id": "R-015",
      "name": "市占率-行业总量矛盾",
      "category": "市场客户",
      "trigger": "自述市占率与行业总量数据在数学上矛盾",
      "logic": "自述市占率 × 行业总量 与自述营收量级冲突，或市占率超过行业实际集中度",
      "data_sources": [
        "行业总量报告",
        "市场集中度数据"
      ],
      "severity": "high",
      "signals": [
        "市场占有率",
        "市占率矛盾"
      ]
    },
    {
      "id": "R-016",
      "name": "大客户-招投标缺失",
      "category": "市场客户",
      "trigger": "声称与某大客户深度合作，但招投标/中标记录无",
      "logic": "声称的客户关系缺乏招投标/合同记录支撑",
      "data_sources": [
        "招投标平台",
        "中标记录"
      ],
      "severity": "high",
      "signals": [
        "招投标记录",
        "中标记录"
      ]
    },
    {
      "id": "R-017",
      "name": "政府背书-中标缺失",
      "category": "市场客户",
      "trigger": "声称政府项目/背书，但无中标或政策文件",
      "logic": "政府资源声称缺乏公开中标/政策依据",
      "data_sources": [
        "政府采购平台",
        "政策文件库"
      ],
      "severity": "high",
      "signals": [
        "政府背书",
        "政府项目",
        "中标"
      ]
    },
    {
      "id": "R-018",
      "name": "出口-海关背离",
      "category": "市场客户",
      "trigger": "自述出口增长，但海关数据下滑",
      "logic": "出口自述与海关统计数据方向矛盾",
      "data_sources": [
        "海关统计数据",
        "出口记录"
      ],
      "severity": "high",
      "signals": [
        "海关数据",
        "出口数据",
        "出口下滑"
      ]
    },
    {
      "id": "R-019",
      "name": "关键材料索取不给",
      "category": "行为验证",
      "trigger": "索要估值证明/上会记录/订单等关键材料始终不给",
      "logic": "关键验证材料拒绝提供 = 交叉验证失败，最强的负证据",
      "data_sources": [
        "沟通记录",
        "材料清单"
      ],
      "severity": "high",
      "signals": [
        "估值证明",
        "上会记录",
        "索要",
        "拒绝提供",
        "材料始终不给"
      ]
    },
    {
      "id": "R-020",
      "name": "技术散射无投产",
      "category": "行为验证",
      "trigger": "技术方向过多但无一投产",
      "logic": "技术叙事分散而无交付落地，'叙事方'特征",
      "data_sources": [
        "业务进展",
        "产品上市记录"
      ],
      "severity": "medium",
      "signals": [
        "技术方向",
        "无一投产",
        "投产"
      ]
    },
    {
      "id": "R-021",
      "name": "压力测试防御反应",
      "category": "行为验证",
      "trigger": "被追问实质问题时攻击对接人身份/转移话题",
      "logic": "对关键问题的防御性攻击反应，可疑信号",
      "data_sources": [
        "会议记录",
        "沟通日志"
      ],
      "severity": "medium",
      "signals": [
        "攻击",
        "追问"
      ]
    },
    {
      "id": "R-022",
      "name": "条款模糊无窗口",
      "category": "行为验证",
      "trigger": "合作条款始终模糊（先做着后面都好说）",
      "logic": "条款模糊且无明确窗口，合作意向弱或动机存疑",
      "data_sources": [
        "协议草案",
        "谈判记录"
      ],
      "severity": "medium",
      "signals": [
        "条款模糊",
        "先做",
        "协议模糊"
      ]
    }
  ]
}